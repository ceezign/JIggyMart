{
    "name": "jiggymart/marketplace",
    "type": "project",
    "description": "A production-quality multi-vendor marketplace built on Laravel.",
    "keywords": ["laravel", "marketplace", "ecommerce"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.16",
        "tymon/jwt-auth": "^2.1",
        "laravel/tinker": "^2.9",
        "intervention/image": "^3.5"
    },
    "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1", 
    "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true, "php-http/discovery": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
